# WorldReel video-generation pipeline environment
# Local (this laptop): CPU-only, Intel Iris Xe, Python 3.12
# Kaggle: T4 GPU (15GB), Python 3.12 via uv venv
#
# Build:  docker build -f Dockerfile.generation -t worldreel-generation .
# Run:    docker run --rm -v $(pwd)/runs:/app/runs worldreel-generation ...
#
# NOTE: This laptop has no NVIDIA GPU. Local container runs CPU-only.
# Kaggle jobs mount this same spec on T4 GPUs.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
        python3-pip \
        ffmpeg \
        git \
        curl \
        ca-certificates \
        libgl1-mesa-glx \
        libglib2.0-0 \
        && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3.12 /usr/bin/python && \
    ln -s /usr/bin/pip3 /usr/bin/pip

WORKDIR /app

# Python dependencies (CPU PyTorch for local; Kaggle jobs install CUDA torch via uv)
RUN pip install --upgrade pip setuptools wheel && \
    pip install \
        numpy==2.5.4 \
        opencv-python-headless==5.0.0 \
        scipy==1.18.0 \
        jsonschema==4.26.0 \
        cryptography==50.0.2 \
        mediapipe==1.2.0 \
        pyloudnorm==0.2.0 \
        numba==0.68.0 \
        opentimelineio==0.18.1 \
        tiktoken==0.14.0 \
        tokenizers==0.23.3 \
        transformers==5.20.1 \
        diffusers==0.41.0 \
        accelerate \
        safetensors \
        ftfy \
        imageio \
        imageio-ffmpeg \
        sentencepiece \
        huggingface_hub \
        onnxruntime \
        pyworld-prebuilt==0.3.6.post1 \
        pytest==8.3.0 \
        ruff==0.8.0 \
        mypy==1.13.0

# Copy project source (data/ and runs/ are excluded via .dockerignore)
COPY formats /app/formats
COPY pipeline /app/pipeline
COPY stages /app/stages
COPY tools /app/tools
COPY eval /app/eval
COPY spec /app/spec
COPY pyproject.toml /app/pyproject.toml
COPY README.md /app/README.md

# Default command
ENTRYPOINT ["python", "-m"]

CMD ["tools.generate_world", "--help"]
